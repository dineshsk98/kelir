# Copy to .env and fill in. Never commit .env.

# Google OAuth client ID (Google Cloud Console > Credentials > OAuth client, Web).
# Authorized JavaScript origins: http://localhost:8000 and http://localhost:5173
GOOGLE_CLIENT_ID=

# Long random string used to sign the session cookie
SESSION_SECRET=

DATABASE_URL=postgresql+asyncpg://<USER>:<password>@<host>:<port>/<database>

# The app's own Gmail account and its app password (needs 2-Step Verification)
SMTP_USER=
SMTP_APP_PASSWORD=

# Address the email links point at (use http://<laptop-LAN-IP>:8000 to open on a phone)
APP_BASE_URL=http://localhost:8000

DEMO_MODE=true

# smtp = real Gmail, console = print emails (development and tests)
MAILER=console
