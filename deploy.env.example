# Copy to deploy.env on the server and fill in. Never commit deploy.env.
# Compose passes it to the app (env_file), but fills the ${...} values in docker-compose.yml only
# from a file named .env: so also run `ln -s deploy.env .env` once (see DEPLOY.md).

# The public address, no https:// (e.g. capsule.example.com). It must already point at this machine.
DOMAIN=

# The same address with https://: the links in emails and the secure cookie use it
APP_BASE_URL=https://

# Passwords and secrets: long and random, letters and digits only (`openssl rand -hex 24`).
# Not base64: the database password goes into a URL, and + / = would break it.
POSTGRES_PASSWORD=
SESSION_SECRET=

# The app's own Gmail account and its app password (needs 2-Step Verification)
MAILER=smtp
SMTP_USER=
SMTP_APP_PASSWORD=
# Optional: another SMTP server (STARTTLS) instead of Gmail's
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# The contact address shown on the privacy page (the person who answers data requests)
SUPPORT_EMAIL=
# Where this server runs, for the privacy page (e.g. a provider and country)
HOSTING_LOCATION=

# Optional: Google sign-in. Needs this domain under "Authorized JavaScript origins" in the
# Google Cloud console. Leave empty to offer sign-in by emailed code only.
GOOGLE_CLIENT_ID=

# true shows the "Simulate their midnight" button (handy for a demo); false for real use
DEMO_MODE=false
